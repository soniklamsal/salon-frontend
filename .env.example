# Copy to .env and fill in. Nothing here is a secret; .env is gitignored and is
# where the real values go. Never put a live key in this file.
#
# There is one file per machine, not one per environment: production values are
# set in the Vercel dashboard under these same names. Six variables, and only
# the first is required to render the site.

# --- Backend ---------------------------------------------------------------

# The Django API. This is the only address the frontend needs to know.
#
# NEXT_PUBLIC_ on purpose: the booking form fetches time slots and posts
# appointments from the browser, so the value must be in the bundle. It is a
# public URL either way. Server components read the same name.
#
# Unset, it falls back to http://localhost:8000/api/v1 and, if nothing is
# listening there, the site still renders from bundled content.
NEXT_PUBLIC_SALON_API_URL=http://localhost:8000/api/v1

# Enable/disable fallback data when the backend is unavailable
# When true (default), the site serves static fallback data captured from the
# backend, allowing the site to display content during maintenance or outages.
# Set to "false" to show "Content Unavailable" when backend is down.
NEXT_PUBLIC_USE_FALLBACK_DATA=true

# Optional, both have working defaults:
#   SALON_API_REVALIDATE   seconds between background refreshes of prerendered
#                          pages (default 60). Lower it while editing content
#                          in the admin.
#   SALON_API_TIMEOUT_MS   how long to wait for the backend before falling back
#                          to bundled content (default 4000).

# --- This site -------------------------------------------------------------

# Where this frontend is served from — NOT the backend. Used for
# `metadataBase`, so every Open Graph tag, canonical URL and sitemap entry
# resolves against it.
#
# MUST be set in production. Left unset it defaults to http://localhost:3000,
# which would publish localhost as this salon's canonical URL in every share
# preview and every sitemap entry.
SALON_SITE_URL=http://localhost:3000

# --- Google sign-in --------------------------------------------------------
# Auth.js (next-auth v5) runs inside this Next server, which is what performs
# the OAuth code exchange — so these are read here and cannot be moved to the
# Django backend. They are server-only: no NEXT_PUBLIC_ prefix, ever, or the
# secrets would be inlined into the browser bundle.
#
# Everything auth-related is behind these, so the site runs unchanged until
# they exist — /services and /status simply stay open and bookings are
# recorded without an account.
#
#   1. Google Cloud console -> APIs & Services -> Credentials
#   2. Create an "OAuth client ID", type "Web application"
#   3. Add these Authorised redirect URIs — BOTH are needed if you develop
#      locally and deploy:
#        http://localhost:3000/api/auth/callback/google
#        https://your-real-domain.com/api/auth/callback/google
#   4. Add your domain under "Authorised JavaScript origins"
#
# The redirect URI must match character for character, including the scheme
# and any trailing path. A mismatch is Google's "redirect_uri_mismatch" error,
# which is the single most common thing to get wrong here.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# Encrypts this site's session cookie. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# Signs the short-lived tokens the browser sends to the Django API, which
# verifies them with the same value. The API's copy is SALON_AUTH_SECRET in
# backend/.env and the two MUST be identical — if they differ, sign-in appears
# to work while every booking is recorded anonymously.
# Generate with:  openssl rand -base64 32
SALON_AUTH_SECRET=

# Optional: AUTH_URL, only where the host cannot be inferred from the request —
# a reverse proxy, or a container behind one. Vercel and localhost both infer
# it, so leave it unset unless sign-in redirects to the wrong host.
